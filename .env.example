# ============================================================================
# HOMA - Environment Variables Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env.local and fill in actual values
# Never commit .env.local to version control!
# ============================================================================

# ============================================================================
# SECURITY - CRITICAL (REQUIRED)
# ============================================================================
# JWT Secret for session tokens
# MUST be changed in production! Generate with: openssl rand -base64 48
# Minimum 32 characters required
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters

# ============================================================================
# DATABASE (REQUIRED)
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Example: postgresql://homa_user:SecurePassword@localhost:5432/homa_production
DATABASE_URL=postgresql://user:password@localhost:5432/homa

# ============================================================================
# APPLICATION
# ============================================================================
# Application URL (used for secure cookies and redirects)
# MUST use HTTPS in production
# Examples:
#   - Production: https://intools.homa.co.id
#   - Staging: https://staging.homa.co.id
#   - Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (development, production)
NODE_ENV=development

# ============================================================================
# SECURITY SETTINGS (Optional - using defaults if not set)
# ============================================================================
# Session timeout in hours (default: 4)
SESSION_TIMEOUT_HOURS=4

# Rate limiting (requests per window)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ============================================================================
# TESTING & DEVELOPMENT FLAGS
# ============================================================================
# Allow payout regeneration (delete existing payouts for same period)
# WARNING: Set to 'false' in production! Only use in dev/staging for testing
# Default: false
ALLOW_PAYOUT_REGENERATION=false

# Bypass end-of-month validation for payout generation
# When true, allows generating payouts anytime (not just end of month)
# WARNING: For testing only! Set to 'false' in production!
# Default: false
PAYOUT_BYPASS_DATE_CHECK=false

# Enable mitra schedule/workload checking
# When true, restricts mitra assignment based on daily workload (max 8 hours)
# When false, allows free assignment regardless of mitra schedule
# Default: false (free assignment)
ENABLE_MITRA_SCHEDULE_CHECK=false

# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# ✅ JWT_SECRET is changed to a strong random value (min 32 chars)
# ✅ DATABASE_URL points to production database
# ✅ NEXT_PUBLIC_APP_URL uses HTTPS
# ✅ NODE_ENV=production
# ✅ .env.local is NOT committed to git
# ✅ Environment variables are set in deployment platform
# ============================================================================